{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-config.schema.json",
  "title": "Video translation pipeline configuration",
  "type": "object",
  "required": ["project_id", "input_video", "output_root", "translation"],
  "properties": {
    "$schema": {"type": "string"},
    "project_id": {"type": "string", "minLength": 1, "description": "Stable identifier written to manifests and QA reports."},
    "input_video": {"type": "string", "minLength": 1, "description": "Source media path, resolved relative to this configuration file."},
    "output_root": {"type": "string", "minLength": 1, "description": "Dedicated directory for resumable project artifacts."},
    "translation": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "source_language": {"type": ["string", "null"], "description": "Source language code, or null for automatic detection."},
        "target_language": {"type": "string", "minLength": 2, "default": "en", "description": "Target language code."},
        "model": {"type": "string", "minLength": 1, "description": "Primary Whisper model name or size."},
        "fallback_model": {"type": ["string", "null"], "description": "Optional stronger Whisper retry model."},
        "translation_model": {"type": "string", "minLength": 1, "description": "Hugging Face translation model identifier."},
        "source_model_language": {"type": ["string", "null"]},
        "target_model_language": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "properties": {
        "device": {"enum": ["auto", "cpu", "cuda"], "default": "auto", "description": "Execution device; auto validates CUDA compatibility before selection."}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "maximum_segment_duration": {"type": "number", "exclusiveMinimum": 0, "default": 12.0, "description": "Maximum cue duration in seconds."},
        "minimum_subtitle_duration": {"type": "number", "exclusiveMinimum": 0, "default": 0.5, "description": "Minimum readable cue duration in seconds."},
        "maximum_subtitle_characters": {"type": "integer", "minimum": 1},
        "maximum_subtitle_line_characters": {"type": "integer", "minimum": 1},
        "maximum_subtitle_lines": {"type": "integer", "minimum": 1},
        "maximum_subtitle_characters_per_second": {"type": "number", "exclusiveMinimum": 0, "default": 20.0, "description": "Maximum target-language reading speed."},
        "minimum_source_event_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.98, "description": "Minimum fraction of detected source speech events represented by cues."},
        "minimum_source_time_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.95, "description": "Minimum fraction of detected source speech time represented by cues."},
        "maximum_low_confidence_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_rejection_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_tempo_factor": {"type": "number", "minimum": 1},
        "maximum_vocal_leakage": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "diarization": {
      "type": "object",
      "properties": {
        "maximum_speakers": {"type": "integer", "minimum": 2},
        "embedding_model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "separation": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "device": {"enum": ["auto", "cpu", "cuda"]},
        "shifts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "dubbing": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": ["string", "null"]},
        "voice": {"type": ["string", "null"]},
        "rate": {"type": "string", "pattern": "^[+-][0-9]+%$"},
        "retries": {"type": "integer", "minimum": 1},
        "preserve_background_audio": {"type": "boolean"},
        "source_volume": {"type": "number", "minimum": 0, "maximum": 2},
        "dub_volume": {"type": "number", "minimum": 0, "maximum": 2},
        "minimum_dialogue_occupancy": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_tempo": {"type": "number", "minimum": 0.5, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
