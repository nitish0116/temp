{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-config.schema.json",
  "title": "Video translation pipeline configuration",
  "type": "object",
  "required": ["project_id", "input_video", "output_root", "translation"],
  "properties": {
    "$schema": {"type": "string"},
    "project_id": {"type": "string", "minLength": 1},
    "input_video": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "translation": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "source_language": {"type": ["string", "null"]},
        "target_language": {"type": "string", "minLength": 2, "default": "en"},
        "model": {"type": "string", "minLength": 1},
        "fallback_model": {"type": ["string", "null"]},
        "translation_model": {"type": "string", "minLength": 1},
        "source_model_language": {"type": ["string", "null"]},
        "target_model_language": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "maximum_segment_duration": {"type": "number", "exclusiveMinimum": 0},
        "maximum_subtitle_characters": {"type": "integer", "minimum": 1},
        "maximum_low_confidence_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_rejection_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_tempo_factor": {"type": "number", "minimum": 1},
        "maximum_vocal_leakage": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "diarization": {
      "type": "object",
      "properties": {
        "maximum_speakers": {"type": "integer", "minimum": 2},
        "embedding_model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "separation": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "device": {"enum": ["cpu", "cuda"]},
        "shifts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "dubbing": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": ["string", "null"]},
        "voice": {"type": ["string", "null"]},
        "rate": {"type": "string", "pattern": "^[+-][0-9]+%$"},
        "retries": {"type": "integer", "minimum": 1},
        "preserve_background_audio": {"type": "boolean"},
        "source_volume": {"type": "number", "minimum": 0, "maximum": 2},
        "dub_volume": {"type": "number", "minimum": 0, "maximum": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
