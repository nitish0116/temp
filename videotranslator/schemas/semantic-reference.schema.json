{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-reference.schema.json",
  "title": "Reviewed subtitle semantic references",
  "type": "object",
  "required": ["schema_version", "references"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "video": {"type": "string", "description": "Optional source-video identifier for reviewers."},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_seconds"],
        "properties": {
          "timestamp_seconds": {"type": "number", "minimum": 0},
          "source": {"type": "string"},
          "burned_reference": {"type": "string"},
          "required_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "forbidden_terms": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "anyOf": [
          {"required": ["required_terms"]},
          {"required": ["forbidden_terms"]}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
